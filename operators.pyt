#ARITHMETICOPERATIONS-used for maths
x=10
y=3
print(x+y) #addition
print(x-y)#substraction
print(x*y)#muLtiplication
print(x/y)# division
print(x//y)#floor division ,removes decimals
print(x%y)#modulus/remainder
print(x**y)#exponent x power y
#COMPARISON OPERATORS operators- used to compare values they give true or false
a=5
b=10
print(a==b) #equal to
print(a!=b)#not equal to
print(a>b)#greater than
print(a<b)#less than
print(a>=5)#ggreater than or equal to
print(b<=9)#less than or equal to
#LOGICAL OPERATORS- used for combining conditions ie and, or ,not
#and both must be true, or at least one is true not then does the reverse
x=7
print(x>5 and x<10) # both must be true
print(x<10 or x<5)# atleast one to be true
print(not(x>5))#dpes reverse it is true but it prints false
#ASSIGNMENT OPERATORS-used to update variables
num=10
num+=5# same as number = number +5
print(num)
num*=3#same as number = number *15
print(num)
#MEMBERSHIP AND IDENTITY OPERATORS
#They include MEMBERSHIP:in, not in IDENTITY: is , is not
fruits=["apple", "banana","mango"]
print("apple" in fruits)
print("orangge" not in fruits)
x=[1, 2,3]
y=x
print(x is y)
print(x is not y)






